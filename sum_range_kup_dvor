// Файл: 01_sum_range.cpp

#include <iostream>
using namespace std;

int main() {
int a,b;
int sum=0;
// ввод
cin>>a>>b;
for(int i=a;i<=b;i++)
{
sum=sum+i;
}
cout<<"sum="<<sum<<endl;
return 0;
}
